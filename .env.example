# Variables de Entorno - Leveling Jump
# Copia este archivo como .env en tu computadora y reemplaza los valores

PORT=4000

# Cadena de conexión al pooler de Supabase (puerto 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-ca-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexión directa para migraciones de Prisma (puerto 5432)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-ca-central-1.pooler.supabase.com:5432/postgres"
