# Variables de Entorno - Leveling Jump
# Copia este archivo como .env en tu computadora y reemplaza los valores

PORT=4000

# Cadena de conexión al pooler de Supabase (puerto 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-ca-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexión directa para migraciones de Prisma (puerto 5432)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-ca-central-1.pooler.supabase.com:5432/postgres"

# Configuración de Envío de Correos (Gmail SMTP - HU-11 / OTP)
# Si se deja en blanco en desarrollo, el sistema imprimirá el código OTP en la consola del servidor
EMAIL_USER="tu-correo@gmail.com"
EMAIL_PASS="tu-app-password-de-16-caracteres"

# Clave Secreta para Tokens JWT
JWT_SECRET="leveling_jump_secure_jwt_token_2026_cesar_sanchez"

# Google Cloud OAuth 2.0 (braided-trees-384500)
GOOGLE_CLIENT_ID="784626326160-u2cbelakbsulgog482jcjlrpb13dc38l.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="tu-google-client-secret"
